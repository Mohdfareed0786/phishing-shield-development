# Supabase project URL and public client key. Never use a service-role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Or use SUPABASE_ANON_KEY for projects that still use legacy anon keys.

# Exact allowed web origins, comma separated. Include the deployed Vercel origin.
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# Optional provider credentials. Missing feeds are reported as not configured.
# When enabled, submitted URLs are sent to the corresponding provider for lookup.
VIRUS_TOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=
ABUSE_IPDB_API_KEY=

PROVIDER_TIMEOUT_SECONDS=8
MAX_REQUEST_BYTES=49152
SCAN_RATE_LIMIT=20
SCAN_RATE_WINDOW_SECONDS=60
